{
  "manifest_version": 3,
  "name": "FreeDM Browser Handoff",
  "version": "1.0.0",
  "description": "Send browser downloads to the FreeDM desktop app instead of the browser.",
  "permissions": ["downloads", "cookies", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "FreeDM handoff"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "freedm@local",
      "strict_min_version": "115.0"
    }
  }
}

{
  "manifest_version": 3,
  "name": "FreeDM Browser Handoff",
  "version": "1.0.0",
  "description": "Send browser downloads to the FreeDM desktop app instead of the browser.",
  "permissions": ["downloads", "cookies", "storage", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "FreeDM handoff"
  }
}
